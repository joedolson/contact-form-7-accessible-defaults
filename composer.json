{
    "name": "joedolson/contact-form-7-accessible-defaults",
    "description": "Contact Form 7: Accessible Defaults",
    "keywords": ["wcag", "wpcf7", "accessibility", "form"],
    "homepage": "https://github.com/joedolson/contact-form-7-accessible-defaults",
    "license": "GPL-2.0-or-later",
    "authors": [{
        "name": "Joseph Dolson",
        "email": "plugins@joedolson.com",
        "homepage": "https://www.joedolson.com"
    }],
    "type": "wordpress-plugin",
    "require-dev": {
        "phpcompatibility/php-compatibility": "^9.3",
        "phpunit/phpunit": "^8.5",
        "wp-coding-standards/wpcs": "^3.0.0",
        "wp-phpunit/wp-phpunit": "^5.8",
        "yoast/phpunit-polyfills": "^1.0",
		"yoast/wp-test-utils": "^1.2",
        "szepeviktor/phpstan-wordpress": "^1.1",
        "phpstan/extension-installer": "^1.1"
    },
    "require": {
        "composer/installers": "~1.0"
    },
    "scripts": {
        "format": "phpcbf --standard=phpcs.xml.dist --report-summary --report-source",
        "lint": "phpcs --standard=phpcs.xml.dist",
        "test": [
            "@php ./vendor/phpunit/phpunit/phpunit"
        ]
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "phpstan/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
